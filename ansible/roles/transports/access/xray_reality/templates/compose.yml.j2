services:
{% if access_xray_dns_profile != 'disabled' %}
  unbound:
    build:
      context: ./unbound
    image: local/nitka-unbound:latest
    container_name: unbound
    restart: unless-stopped
    init: true
    dns_search: []
    networks:
      xray_dns:
        ipv4_address: "{{ access_xray_unbound_ipv4 }}"
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=32m,mode=1777
    volumes:
      - ./unbound/unbound.conf:/opt/unbound/etc/unbound/unbound.conf:ro
      - xray_unbound_rpz:/opt/unbound/etc/unbound/rpz
    expose:
      - "5353"
    healthcheck:
      test: ["CMD", "/usr/local/bin/healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    logging:
      driver: none

{% endif %}
  xray:
    image: {{ access_xray_image }}
    container_name: {{ access_xray_container_name }}
    command: ["run", "-c", "/etc/xray/config.json"]
{% if access_xray_dns_profile != 'disabled' %}
    depends_on:
      unbound:
        condition: service_healthy
    networks:
      - xray_dns
{% endif %}
    healthcheck:
      test: ["CMD", "xray", "run", "-test", "-config=/etc/xray/config.json"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 10s
    restart: unless-stopped
    read_only: true
    cap_drop: ["ALL"]
    security_opt:
      - no-new-privileges:true
    pids_limit: 512
    mem_limit: 512m
    ulimits:
      nofile: 262144
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,mode=1777
    volumes:
      - ./config.json:/etc/xray/config.json:ro
    ports:
      - "{{ access_xray_state.vision_port }}:{{ access_xray_state.vision_port }}/tcp"
      - "{{ access_xray_state.xhttp_port }}:{{ access_xray_state.xhttp_port }}/tcp"

{% if access_xray_dns_profile != 'disabled' %}
volumes:
  xray_unbound_rpz:

networks:
  xray_dns:
    ipam:
      config:
        - subnet: "{{ access_xray_dns_network_subnet }}"
{% endif %}
