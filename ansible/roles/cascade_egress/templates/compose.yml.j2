name: cascade-egress

services:
  {{ transport_backhaul_service_name | default('ssh_tun_server') }}:
    container_name: {{ transport_backhaul_container_name | default('cascade-ssh-tun-server') }}
    build:
      context: ./{{ transport_backhaul_remote_dir_name | default('ssh_tun_server') }}
    image: local/cascade-ssh-tun-server:latest
    env_file:
      - ./{{ transport_backhaul_remote_dir_name | default('ssh_tun_server') }}/security.env
    cap_add:
      - NET_ADMIN
      - NET_RAW
      - SYS_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    volumes:
      - ./{{ transport_backhaul_remote_dir_name | default('ssh_tun_server') }}/authorized_keys:/run/cascade/authorized_keys:ro
      - ./{{ transport_backhaul_remote_dir_name | default('ssh_tun_server') }}/ssh_host_ed25519_key:/etc/ssh/ssh_host_ed25519_key:ro
      - ./{{ transport_backhaul_remote_dir_name | default('ssh_tun_server') }}/ssh_host_ed25519_key.pub:/etc/ssh/ssh_host_ed25519_key.pub:ro
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "/usr/local/bin/healthcheck"]
      interval: {{ transport_backhaul_healthcheck_interval | default('30s') }}
      timeout: {{ transport_backhaul_healthcheck_timeout | default('5s') }}
      retries: {{ transport_backhaul_healthcheck_retries | default(3) }}
      start_period: {{ transport_backhaul_healthcheck_start_period | default('20s') }}
    ports:
      - "{{ transport_backhaul_external_port | default(cascade_ssh_tun_ssh_port) }}:{{ transport_backhaul_internal_port | default(cascade_ssh_tun_container_port) }}"
    networks:
      cascade_egress:
        ipv4_address: {{ transport_backhaul_container_ipv4 | default(cascade_ssh_tun_network_container_vpn_ipv4) }}
    dns_search: []
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=32m,mode=1777
    pids_limit: 150
    mem_limit: 128m
    memswap_limit: 128m
    cpus: 0.50
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  unbound:
    container_name: cascade-unbound
    build:
      context: ./dns
    image: local/cascade-unbound:latest
    depends_on:
      {{ transport_backhaul_service_name | default('ssh_tun_server') }}:
        condition: service_healthy
    network_mode: "service:{{ transport_backhaul_service_name | default('ssh_tun_server') }}"
    volumes:
      - ./dns/unbound.conf:/etc/unbound/unbound.conf:ro
      - ./dns/unbound.conf.d:/etc/unbound/unbound.conf.d:ro
    init: true
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "/usr/local/bin/healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    dns_search: []
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=32m,mode=1777
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  cascade_egress:
    name: cascade_egress
    driver: bridge
    ipam:
      config:
        - subnet: {{ transport_backhaul_container_subnet | default(cascade_ssh_tun_network_container_subnet_cidr_ipv4) }}
          gateway: {{ transport_backhaul_container_gateway | default(cascade_ssh_tun_network_container_gateway_ipv4) }}
